package {{ package }};

import org.springframework.web.bind.annotation.*;
import org.springframework.http.ResponseEntity;
{% if dubbo_ref %}
import org.apache.dubbo.config.annotation.DubboReference;
{% endif %}
{% for imp in imports %}
import {{ imp }};
{% endfor %}

/**
 * REST Controller: {{ class_name }}
 * Auto-generated by crewai-microservice-builder
 */
@RestController
@RequestMapping("{{ base_path }}")
public class {{ class_name }} {

{% if dubbo_ref %}
    @DubboReference(version = "{{ dubbo_version }}", group = "{{ dubbo_group }}")
    private {{ dubbo_ref.interface.split('.')[-1] }} {{ dubbo_ref.field_name }};

{% endif %}
{% for ep in endpoints %}
    /**
     * {{ ep.http_method | default(ep.method) | upper }} {{ base_path }}{{ ep.path | default('') }}
     * {{ ep.description | default('') }}
     */
    @{{ ep.http_method | default(ep.method) | capitalize }}Mapping("{{ ep.path | default('') }}")
    public ResponseEntity<{{ ep.response_type | default('Object') }}> {{ ep.method_name | default(ep.handler_name) | default('handle') }}(
{%- set ep_params = ep.params | default([]) %}
{%- if ep_params %}

{% for param in ep_params %}
{%- if param.source | default('query') == 'body' %}
            @RequestBody {{ param.type }} {{ param.name }}
{%- elif param.source | default('query') == 'path' %}
            @PathVariable {{ param.type }} {{ param.name }}
{%- else %}
            @RequestParam(required = false) {{ param.type }} {{ param.name }}
{%- endif %}
{%- if not loop.last %},{% endif %}

{% endfor %}
    ) {
{% else %}) {
{% endif %}
        // TODO: implement {{ ep.method_name | default(ep.handler_name) | default('handle') }}
{% if dubbo_ref %}
        // Delegate to: {{ dubbo_ref.field_name }}.{{ ep.method_name | default(ep.handler_name) | default('handle') }}(...)
{% endif %}
        return ResponseEntity.ok(null);
    }

{% endfor %}
}
